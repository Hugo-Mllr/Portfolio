# Variables de la stack Portainer. Ce fichier est un MODÈLE : ne jamais y mettre de vraies valeurs.
# Les vraies valeurs se saisissent dans Portainer (Stack > Environment variables) ou dans un .env local ignoré par git.

# Image à déployer (publiée par GitHub Actions)
IMAGE=ghcr.io/hugo-mllr/portfolio:latest

# SECRET : jeton du tunnel Cloudflare (Zero Trust > Networking > Tunnels > ton tunnel). Ne jamais committer.
TUNNEL_TOKEN=

# Optionnels
WEB_PORT=8080
CLOUDFLARED_VERSION=2026.11.0

# NB : SITE_URL n'est PAS lu au runtime. C'est une variable de build : la définir dans GitHub
# (Settings > Secrets and variables > Actions > Variables) pour les liens canoniques / sitemap.

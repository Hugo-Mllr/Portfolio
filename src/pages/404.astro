---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
const lang = 'fr';
---
<Base lang={lang} title="404">
  <section class="wrap" style="padding:120px var(--gutter);text-align:center">
    <p style="font-size:4rem" aria-hidden="true">♚</p>
    <h1 style="font:400 clamp(2rem,5vw,3.6rem)/1.1 var(--font-serif);margin:12px 0">{t(lang, '404.title')}</h1>
    <p style="color:var(--mute);max-width:460px;margin:0 auto 28px">{t(lang, '404.text')}</p>
    <a href="/fr/" style="display:inline-block;padding:13px 22px;border:1px solid var(--accent);color:var(--accent-2);border-radius:var(--radius);font-weight:600">{t(lang, '404.back')}</a>
  </section>
</Base>

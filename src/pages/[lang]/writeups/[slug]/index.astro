---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Prose from '../../../../components/Prose.astro';
import { langs, localePath, t, type Lang, type UiKey } from '../../../../i18n/ui';
import { getWriteups, fmtDate } from '../../../../lib/content';

export async function getStaticPaths() {
  const all = await getWriteups();
  return langs.flatMap((lang) => all.map((w) => ({ params: { lang, slug: w.id }, props: { entry: w } })));
}
const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Base lang={lang} current="writeups" title={d.title} description={d.summary ?? `${d.ctf} — ${t(lang, `cat.${d.category}` as UiKey)}`} type="article">
  <div class="wrap layout">
    <aside class="side">
      <a class="back" href={localePath(lang, 'writeups/')}>← {t(lang, 'writeup.back')}</a>
      {toc.length > 0 && (
        <nav class="toc" aria-label={t(lang, 'project.toc')}>
          <p class="toc-h">{t(lang, 'project.toc')}</p>
          <ol>{toc.map((h) => <li class:list={{ sub: h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
    </aside>
    <article class="article">
      <header class="head">
        <p class="eyebrow">{d.ctf}</p>
        <h1>{d.title}</h1>
        {d.summary && <p class="lead">{d.summary}</p>}
        <dl class="facts">
          <div><dt>{t(lang, 'writeup.category')}</dt><dd>{t(lang, `cat.${d.category}` as UiKey)}</dd></div>
          {d.difficulty && <div><dt>{t(lang, 'writeup.difficulty')}</dt><dd>{t(lang, `diff.${d.difficulty}` as UiKey)}</dd></div>}
          {d.points !== undefined && <div><dt>{t(lang, 'writeup.points')}</dt><dd>{d.points}</dd></div>}
          <div><dt>{t(lang, 'writeup.date')}</dt><dd>{fmtDate(d.date, lang)}</dd></div>
        </dl>
        {d.tags.length > 0 && <ul class="tags">{d.tags.map((tag) => <li class="tag">{tag}</li>)}</ul>}
        {d.draft && <p class="notice">{t(lang, 'project.draft')}</p>}
      </header>
      <Prose><Content /></Prose>
    </article>
  </div>
</Base>
<style>
  .layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 56px; padding-top: 56px; padding-bottom: 110px; align-items: start; }
  .side { position: sticky; top: calc(var(--nav-h) + 28px); max-height: calc(100dvh - var(--nav-h) - 56px); overflow: auto; }
  .back { font: 500 .8rem var(--font-mono); color: var(--accent-2); }
  .toc { margin-top: 28px; border-left: 1px solid var(--line); padding-left: 16px; }
  .toc-h { font: 500 .72rem var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--mute); margin-bottom: 10px; }
  .toc ol { list-style: none; display: grid; gap: 2px; }
  .toc li.sub { padding-left: 14px; }
  .toc a { display: block; padding: 4px 0; font-size: .88rem; color: var(--mute); transition: color .2s, transform .2s var(--ease); }
  .toc a:hover { color: var(--accent-2); transform: translateX(4px); }
  .eyebrow { font: 500 .8rem var(--font-mono); color: var(--accent); letter-spacing: .14em; text-transform: uppercase; }
  h1 { font: 400 clamp(2.1rem, 5vw, 3.4rem)/1.08 var(--font-serif); margin: 14px 0 16px; letter-spacing: -.02em; }
  .lead { color: var(--mute); font-size: 1.1rem; max-width: 62ch; }
  .facts { display: flex; flex-wrap: wrap; gap: 14px 36px; margin-top: 26px; padding: 18px 20px; background: var(--ink-2); border: 1px solid var(--line); border-radius: var(--radius); }
  .facts dt { font: 500 .7rem var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--mute); }
  .facts dd { font: 600 1rem var(--font-sans); color: var(--ivory); }
  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .tag { font: 500 .72rem var(--font-mono); padding: 4px 10px; border: 1px solid var(--line); border-radius: 3px; }
  .notice { margin-top: 18px; font-size: .9rem; border: 1px dashed var(--accent); color: var(--accent-2); padding: 10px 14px; border-radius: var(--radius); }
  .head { margin-bottom: 44px; }
  @media (max-width: 960px) { .layout { grid-template-columns: 1fr; gap: 28px; } .side { position: static; max-height: none; } .toc { display: none; } }
</style>

---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { langs, localePath, t, type Lang, type UiKey } from '../../../i18n/ui';
import { getWriteups, fmtDate } from '../../../lib/content';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const writeups = await getWriteups();
const categories = [...new Set(writeups.map((w) => w.data.category))];
const catLabel = (c: string) => t(lang, `cat.${c}` as UiKey);
---
<Base lang={lang} current="writeups" title={t(lang, 'nav.writeups')} description={t(lang, 'writeups.intro')}>
  <PageHead eyebrow={t(lang, 'writeups.sub')} title={t(lang, 'writeups.title')} intro={t(lang, 'writeups.intro')} />
  <section class="wrap list">
    {writeups.length === 0 ? (
      <p class="empty" data-reveal>{t(lang, 'writeups.empty')}</p>
    ) : (
      <>
        <div class="tools" data-reveal>
          <div class="chips" role="group" aria-label={t(lang, 'writeup.category')}>
            <button type="button" class="chip on" data-cat="all" aria-pressed="true">{t(lang, 'writeups.all')}</button>
            {categories.map((c) => <button type="button" class="chip" data-cat={c} aria-pressed="false">{catLabel(c)}</button>)}
          </div>
          <label class="search"><span class="sr-only">{t(lang, 'writeups.search')}</span><input type="search" placeholder={t(lang, 'writeups.search')} data-search autocomplete="off" /></label>
        </div>
        <ul class="grid" data-stagger>
          {writeups.map((w) => (
            <li data-card data-cat={w.data.category} data-text={`${w.data.title} ${w.data.ctf} ${w.data.tags.join(' ')}`.toLowerCase()}>
              <a class="card" href={localePath(lang, `writeups/${w.id}/`)}>
                <div class="top">
                  <span class="cat">{catLabel(w.data.category)}</span>
                  {w.data.difficulty && <span class={`diff ${w.data.difficulty}`}>{t(lang, `diff.${w.data.difficulty}` as UiKey)}</span>}
                </div>
                <h2>{w.data.title}</h2>
                <p class="ctf">{w.data.ctf}</p>
                {w.data.summary && <p class="sum">{w.data.summary}</p>}
                <div class="foot">
                  <span>{fmtDate(w.data.date, lang)}</span>
                  {w.data.points !== undefined && <span>{w.data.points} pts</span>}
                  <span class="lng">{w.data.lang.toUpperCase()}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <p class="empty none" data-none hidden>{t(lang, 'writeups.none')}</p>
      </>
    )}
  </section>
</Base>
<style>
  .list { padding-bottom: 110px; }
  .empty { color: var(--mute); padding: 40px 0; border: 1px dashed var(--line); text-align: center; border-radius: var(--radius); }
  .tools { display: flex; gap: 18px; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 32px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font: 600 .75rem var(--font-mono); letter-spacing: .06em; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; background: none; color: var(--mute); cursor: pointer; transition: all .25s var(--ease); }
  .chip:hover { color: var(--accent-2); border-color: var(--accent); }
  .chip.on { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .search input { background: var(--ink-2); border: 1px solid var(--line); color: var(--ivory); font: 500 .88rem var(--font-mono); padding: 10px 16px; border-radius: 999px; width: min(320px, 100%); transition: border-color .2s; }
  .search input:focus { outline: none; border-color: var(--accent); }
  .grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
  .card { display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 24px; background: var(--ink-2); border: 1px solid var(--line); transition: border-color .3s, transform .4s var(--ease), box-shadow .4s; }
  .card:hover, .card:focus-visible { border-color: var(--accent); transform: translateY(-5px); box-shadow: 0 18px 40px rgb(0 0 0 / .4), 0 0 0 1px rgb(var(--accent-rgb) / .25); }
  .top { display: flex; justify-content: space-between; align-items: center; font: 600 .7rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .cat { color: var(--accent); }
  .diff { padding: 3px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--mute); }
  .diff.easy { color: var(--ok); border-color: var(--ok); } .diff.hard, .diff.insane { color: #ff7a7a; border-color: #ff7a7a; }
  h2 { font: 700 1.3rem/1.25 var(--font-serif); }
  .ctf { font: 500 .8rem var(--font-mono); color: var(--accent-2); }
  .sum { color: var(--mute); font-size: .92rem; }
  .foot { margin-top: auto; padding-top: 14px; display: flex; gap: 14px; font: 500 .74rem var(--font-mono); color: var(--mute); border-top: 1px solid var(--line); }
  .lng { margin-left: auto; }
  [hidden] { display: none !important; }
</style>
<script>
  import gsap from 'gsap';
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-cat].chip')];
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const none = document.querySelector<HTMLElement>('[data-none]');
  let cat = 'all';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function apply() {
    const q = (search?.value ?? '').trim().toLowerCase();
    let shown = 0;
    cards.forEach((c) => {
      const ok = (cat === 'all' || c.dataset.cat === cat) && (!q || (c.dataset.text ?? '').includes(q));
      const was = !c.hidden;
      c.hidden = !ok;
      if (ok) shown++;
      if (ok && !was && !reduced) gsap.fromTo(c, { opacity: 0, y: 18, scale: 0.97 }, { opacity: 1, y: 0, scale: 1, duration: 0.5, ease: 'power3.out' });
    });
    if (none) none.hidden = shown !== 0;
  }
  chips.forEach((b) =>
    b.addEventListener('click', () => {
      cat = b.dataset.cat ?? 'all';
      chips.forEach((x) => { const on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); });
      apply();
    })
  );
  search?.addEventListener('input', apply);
</script>

---
import Base from '../../layouts/Base.astro';
import { langs, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} current="home">
  <section class="wrap" style="padding:96px var(--gutter)">
    <p style="font:500 .8rem var(--font-mono);color:var(--accent);letter-spacing:.14em;text-transform:uppercase">{t(lang, 'site.tagline')}</p>
    <h1 style="font:400 clamp(2.4rem,6vw,4.6rem)/1.05 var(--font-serif);margin-top:16px">Hugo Muller</h1>
  </section>
</Base>

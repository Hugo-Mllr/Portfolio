---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Moves from '../../components/Moves.astro';
import Pieces from '../../components/Pieces.astro';
import Contact from '../../components/Contact.astro';
import Marquee from '../../components/Marquee.astro';
import { langs, type Lang } from '../../i18n/ui';
import { getProjects } from '../../lib/content';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const hasProjects = (await getProjects(lang)).length > 0;
---
<Base lang={lang} current="home">
  <Hero lang={lang} hasProjects={hasProjects} />
  <Marquee items={['Wazuh', 'SIEM', 'Docker Swarm', 'Linux', 'Réseau', 'CTF', 'Home lab', 'Détection', 'Défense en profondeur']} />
  <Moves lang={lang} />
  <Pieces lang={lang} />
  <Contact lang={lang} />
</Base>

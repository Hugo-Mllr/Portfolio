---
import SectionHead from './SectionHead.astro';
import { copy, levels, pieces } from '../data/home';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
---
<section id="pieces" class="sec" aria-labelledby="pieces-h">
  <div class="wrap">
    <SectionHead id="pieces-h" title={c.piecesTitle} sub={c.piecesSub} />
    <ul class="pieces" data-stagger>
      {pieces.map((p) => (
        <li class="piece">
          <span class="glyph" aria-hidden="true">{p.glyph}</span>
          <div>
            <small>{levels[p.level][lang]}</small>
            <h3>{p.title[lang]}</h3>
            <p>{p.text[lang]}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .sec { padding: 88px 0; border-top: 1px solid var(--line); }
  .pieces { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .piece { background: var(--ink-2); border: 1px solid var(--line); padding: 26px; display: flex; gap: 20px; transition: border-color .3s, transform .4s var(--ease); }
  .piece:hover { border-color: var(--accent); transform: translateY(-4px); }
  .glyph { font-size: 3rem; line-height: 1; color: var(--accent-2); flex: none; transition: transform .5s var(--ease); }
  .piece:hover .glyph { transform: rotate(-8deg) scale(1.12); }
  small { display: block; font: 500 .72rem var(--font-mono); color: var(--accent); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 6px; }
  h3 { font: 700 1.2rem var(--font-serif); }
  p { color: var(--mute); font-size: .92rem; }
</style>

---
// Mise en forme du contenu Markdown/MDX (projets, writeups).
---
<div class="prose" data-prose><slot /></div>
<style is:global>
  .prose { color: #ddd7c8; font-size: 1.04rem; line-height: 1.75; max-width: 74ch; }
  .prose > * + * { margin-top: 1.1em; }
  .prose h1, .prose h2, .prose h3, .prose h4 { font-family: var(--font-serif); color: var(--ivory); line-height: 1.2; letter-spacing: -.01em; scroll-margin-top: calc(var(--nav-h) + 20px); }
  .prose h2 { font-size: 1.9rem; margin-top: 2.2em; padding-bottom: .35em; border-bottom: 1px solid var(--line); }
  .prose h3 { font-size: 1.4rem; margin-top: 1.8em; }
  .prose h4 { font-size: 1.1rem; margin-top: 1.5em; color: var(--accent-2); }
  .prose a { color: var(--accent-2); text-decoration: underline; text-decoration-color: rgb(var(--accent-rgb) / .5); text-underline-offset: 3px; transition: text-decoration-color .2s; }
  .prose a:hover { text-decoration-color: var(--accent-2); }
  .prose strong { color: var(--ivory); }
  .prose ul, .prose ol { padding-left: 1.4em; }
  .prose li + li { margin-top: .35em; }
  .prose li::marker { color: var(--accent); }
  .prose blockquote { border-left: 3px solid var(--accent); background: var(--ink-2); padding: 14px 20px; border-radius: 0 var(--radius) var(--radius) 0; color: var(--mute); }
  .prose blockquote > * + * { margin-top: .6em; }
  .prose code:not(pre code) { font: 500 .88em var(--font-mono); background: var(--ink-2); border: 1px solid var(--line); padding: .12em .4em; border-radius: 3px; color: var(--accent-2); }
  .prose pre { position: relative; font: 400 .86rem/1.65 var(--font-mono); background: #0a0a0d !important; border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; overflow-x: auto; }
  .prose pre code { font: inherit; background: none; border: 0; padding: 0; color: inherit; }
  .prose img { border: 1px solid var(--line); border-radius: var(--radius); margin-inline: auto; }
  .prose figure figcaption, .prose img + em { display: block; text-align: center; color: var(--mute); font-size: .85rem; margin-top: .5em; }
  .prose hr { border: 0; border-top: 1px solid var(--line); margin: 2.4em 0; }
  .prose table { width: 100%; border-collapse: collapse; font-size: .92rem; display: block; overflow-x: auto; }
  .prose th, .prose td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .prose th { font: 600 .75rem var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
  .prose details { border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 16px; background: var(--ink-2); }
  .prose summary { cursor: pointer; font-weight: 600; color: var(--accent-2); }
  .prose .copy { position: absolute; top: 8px; right: 8px; font: 500 .7rem var(--font-mono); background: var(--ink-2); color: var(--mute); border: 1px solid var(--line); border-radius: 3px; padding: 4px 9px; cursor: pointer; opacity: 0; transition: opacity .2s, color .2s; }
  .prose pre:hover .copy, .prose .copy:focus-visible { opacity: 1; }
  .prose .copy:hover { color: var(--accent-2); }
  .todo-note { border: 1px dashed var(--accent); color: var(--accent-2); padding: 12px 16px; border-radius: var(--radius); }
</style>
<script>
  // Bouton « copier » sur chaque bloc de code
  document.querySelectorAll<HTMLPreElement>('[data-prose] pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy';
    btn.textContent = document.documentElement.lang === 'en' ? 'Copy' : 'Copier';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
        const old = btn.textContent;
        btn.textContent = '✓';
        setTimeout(() => (btn.textContent = old), 1400);
      } catch {}
    });
    pre.appendChild(btn);
  });
</script>

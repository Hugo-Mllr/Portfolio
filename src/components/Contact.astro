---
import { copy } from '../data/home';
import { site } from '../data/site';
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
---
<section id="contact" class="mate" aria-labelledby="contact-h" data-rail={t(lang, 'nav.contact')}>
  <span class="king" aria-hidden="true">♚</span>
  <div class="wrap" data-reveal>
    <h2 id="contact-h" class="big" set:html={c.mate} />
    <p>{c.mateText}</p>
    <div class="cta">
      {site.email && (
        <>
          <a class="btn pri" href="#contact" rel="nofollow" data-mail data-u={site.email.user} data-d={site.email.domain} data-magnetic>{c.contactCta}</a>
          <noscript><span class="nojs">{c.noscriptMail}</span></noscript>
        </>
      )}
      {site.linkedin && <a class="btn sec" href={site.linkedin} rel="noopener" data-magnetic>LinkedIn</a>}
      <a class="btn sec" href={site.github} rel="noopener" data-magnetic>GitHub</a>
    </div>
    {site.cvs && (
      <p class="cvs">{c.cvTitle} :
        <a href={site.cvs.alternance} download="Hugo-Muller-CV-Alternance.pdf" lang="fr">{c.cvAlternance}</a>
        <span aria-hidden="true">·</span>
        <a href={site.cvs.internship} download="Hugo-Muller-CV-Internship.pdf" lang="en">{c.cvInternship}</a>
      </p>
    )}
  </div>
</section>
<style>
  .mate { text-align: center; padding: 110px 0; border-top: 1px solid var(--line); background: radial-gradient(ellipse at center, rgb(var(--accent-rgb) / .12), transparent 65%); position: relative; overflow: clip; }
  .king { position: absolute; left: 7%; bottom: 15%; font-size: clamp(7rem, 17vw, 15rem); line-height: 1; color: var(--accent); opacity: .16; pointer-events: none; }
  .big { font: 400 clamp(2.4rem, 7vw, 5.6rem)/1 var(--font-serif); letter-spacing: -.02em; }
  .big :global(em) { color: var(--accent-2); }
  p { color: var(--mute); margin: 22px auto 34px; max-width: 560px; }
  .cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; align-items: center; }
  .btn { display: inline-flex; padding: 13px 22px; border-radius: var(--radius); font-weight: 600; font-size: .92rem; border: 1px solid var(--accent); transition: background .25s, color .25s; }
  .btn.pri { background: var(--accent); color: var(--on-accent); } .btn.pri:hover { background: var(--accent-2); }
  .btn.sec { color: var(--accent-2); } .btn.sec:hover { background: rgb(var(--accent-rgb) / .1); }
  p.cvs { margin: 28px 0 0; font: 500 .85rem var(--font-mono); color: var(--mute); display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .cvs a { color: var(--accent-2); border-bottom: 1px solid var(--accent); padding-bottom: 1px; }
  .nojs { font: 500 .85rem var(--font-mono); color: var(--accent-2); }
</style>
<script>
  // Assemble l'adresse e-mail au dernier moment (non présente telle quelle dans le HTML servi).
  document.querySelectorAll<HTMLAnchorElement>('[data-mail]').forEach((a) => {
    a.href = `mailto:${a.dataset.u}@${a.dataset.d}`;
  });
</script>

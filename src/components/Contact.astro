---
import { copy } from '../data/home';
import { site } from '../data/site';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const primary = site.email ? { href: `mailto:${site.email}`, label: c.contactCta } : null;
---
<section id="contact" class="mate" aria-labelledby="contact-h">
  <div class="wrap" data-reveal>
    <h2 id="contact-h" class="big" set:html={c.mate} />
    <p>{c.mateText}</p>
    <div class="cta">
      {primary && <a class="btn pri" href={primary.href} data-magnetic>{primary.label}</a>}
      <a class="btn sec" href={site.github} rel="noopener" data-magnetic>GitHub</a>
      {site.linkedin && <a class="btn sec" href={site.linkedin} rel="noopener" data-magnetic>LinkedIn</a>}
    </div>
  </div>
</section>
<style>
  .mate { text-align: center; padding: 110px 0; border-top: 1px solid var(--line); background: radial-gradient(ellipse at center, rgb(var(--accent-rgb) / .12), transparent 65%); }
  .big { font: 400 clamp(2.4rem, 7vw, 5.6rem)/1 var(--font-serif); letter-spacing: -.02em; }
  .big :global(em) { color: var(--accent-2); }
  p { color: var(--mute); margin: 22px auto 34px; max-width: 520px; }
  .cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn { display: inline-flex; padding: 13px 22px; border-radius: var(--radius); font-weight: 600; font-size: .92rem; border: 1px solid var(--accent); transition: background .25s, color .25s; }
  .btn.pri { background: var(--accent); color: var(--on-accent); } .btn.pri:hover { background: var(--accent-2); }
  .btn.sec { color: var(--accent-2); } .btn.sec:hover { background: rgb(var(--accent-rgb) / .1); }
</style>

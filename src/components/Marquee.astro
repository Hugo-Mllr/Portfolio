---
interface Props { items: string[] }
const { items } = Astro.props;
const glyphs = ['♟', '♞', '♝', '♜', '♛', '♚'];
---
<div class="marquee" aria-hidden="true">
  <div class="track" data-marquee-track>
    {[0, 1].map(() => (
      <div class="group">
        {items.map((it, i) => (<><span class="item">{it}</span><span class="sep">{glyphs[i % glyphs.length]}</span></>))}
      </div>
    ))}
  </div>
</div>
<style>
  .marquee { border-block: 1px solid var(--line); background: var(--ink-2); overflow: hidden; padding: 18px 0; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { display: flex; width: max-content; animation: slide 38s linear infinite; will-change: transform; }
  .group { display: flex; align-items: center; flex: none; }
  .item { font: 400 clamp(1.4rem, 3vw, 2.2rem) var(--font-serif); font-style: italic; white-space: nowrap; color: var(--ivory); padding: 0 1.2rem; }
  .sep { color: var(--accent); font-size: 1.4rem; }
  .item:nth-of-type(3n) { color: var(--accent-2); }
  @keyframes slide { to { transform: translateX(-50%); } }
</style>
